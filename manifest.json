{
    "name": "Edit Pager",
	"description": "Edit pager chrome extension that allow you edit web page withing the chrome tab.",
    "icons":{
        "128":"icon.png"
    },
    "version": "1.0.0",
    "manifest_version": 3,
    "action": {
        "default_title": "Edit Pager",
        "default_popup": "js/index.html",
        "default_icon": "icon.png"
    },
    "permissions": [
        "activeTab"
    ],
    "background": {
        "service_worker": "background.js"
    }
}